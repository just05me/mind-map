# Скопируйте в .env и подставьте свои значения.
# Файл .env не коммитьте. В production задайте длинный случайный SESSION_SECRET
# и отдельный сильный POSTGRES_PASSWORD — не оставляйте значения из примера.

NODE_ENV=development
PORT=3000

# Локальная Postgres из `docker compose up db`
DATABASE_URL=postgresql://mindmap:mindmap@127.0.0.1:5432/mindmap

# Случайная строка. В production — не короче 32 символов.
SESSION_SECRET=local-dev-only-generate-a-long-random-string

# Список origin через запятую. Звёздочка запрещена: cookie требует точный origin.
# В production доски: CORS_ORIGIN=https://app.ffinance.uz
# Лендинг на https://ffinance.uz в API не ходит — в список его не добавляйте.
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Только для docker compose (сервис db). В production замените.
POSTGRES_PASSWORD=mindmap
